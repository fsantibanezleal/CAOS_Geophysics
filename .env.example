# Configure the sole ML VPS service from a private environment file, not this repo.
# Default access uses internally provisioned SQLite accounts, without SMTP.
GEOPHYSICS_AUTH_MODE=local
# GEOPHYSICS_AUTH_SECRET: required private random secret, at least 32 characters.
# GEOPHYSICS_PUBLIC_ORIGIN: required exact HTTPS origin of this application.
# GEOPHYSICS_DATA_DIR: absolute private project storage, outside the web root.
# GEOPHYSICS_DB_PATH: absolute migrated SQLite database path.
# GEOPHYSICS_MT_ONLINE_ENABLED=1 only after actual-host method admission.
