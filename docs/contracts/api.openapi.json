                "contentEncoding": "binary"
              }
            },
            "application/geotiff": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "application/vnd.fdsn.mseed": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "application/xml": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "text/xml": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "application/x-segy": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
