            "csrfCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas/api-payloads.schema.json#/$defs/EmailRequest"
              }
            }
          }
        },
        "x-registered-when": "auth_mode=email"
      }
    },
    "/api/auth/reset-password/reset-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "resetPassword",
        "responses": {
          "200": {
            "description": "Password reset completed."
          },
          "400": {
            "$ref": "#/components/responses/AuthError"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "csrfCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas/api-payloads.schema.json#/$defs/PasswordReset"
              }
            }
          }
        },
        "x-registered-when": "auth_mode=email"
      }
    },
    "/api/projects": {
