{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "CAOS Geophysics private-state API",
    "version": "1.0.0",
    "summary": "OpenAPI description of the implemented authenticated API routes.",
    "description": "Static contract for app/server.py. Email account routes are registered only when auth_mode=email. The physical participant adds no routes; it participates in existing DELETE/upload/dataset paths. Public pages and browser-local calculations are outside this API. This contract describes the current implementation; it does not change runtime behavior."
  },
  "servers": [
    {
      "url": "https://geophysics.ml.fasl-work.com",
      "description": "Configured ML VPS origin; deployment availability is not implied."
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Cookie session, CSRF and configuration."
    },
    {
      "name": "projects",
      "description": "Owner-scoped projects and original source assets."
    },
    {
      "name": "processing",
      "description": "Immutable datasets and bounded jobs/results."
    }
  ],
  "security": [
    {
      "apiSession": []
    }
  ],
  "paths": {
    "/api/auth/config": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getAuthConfig",
        "responses": {
          "200": {
            "description": "Configured auth mode and enabled email flows.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/api-payloads.schema.json#/$defs/AuthConfig"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "description": "CSRF token; also sets the HttpOnly CSRF cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/api-payloads.schema.json#/$defs/CsrfToken"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Current active account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/api-payloads.schema.json#/$defs/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/cookie/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "loginCookie",
        "responses": {
          "204": {
            "description": "Authenticated; sets session cookie.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/AuthError"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "csrfCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/cookie/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logoutCookie",
        "responses": {
          "204": {
            "description": "Session cookie cleared."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "apiSession": [],
            "csrfToken": [],
            "csrfCookie": []
          }
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "registerAccount",
        "responses": {
          "201": {
            "description": "Created account; verification email is requested.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/api-payloads.schema.json#/$defs/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/AuthError"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "csrfCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas/api-payloads.schema.json#/$defs/UserCreate"
              }
            }
          }
        },
        "x-registered-when": "auth_mode=email"
      }
    },
    "/api/auth/verify/request": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "requestVerification",
        "responses": {
          "202": {
            "description": "Verification request accepted."
          },
          "400": {
            "$ref": "#/components/responses/AuthError"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "csrfCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas/api-payloads.schema.json#/$defs/EmailRequest"
              }
            }
          }
        },
        "x-registered-when": "auth_mode=email"
      }
    },
    "/api/auth/verify/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "verifyAccount",
        "responses": {
          "200": {
            "description": "Verified account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/api-payloads.schema.json#/$defs/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/AuthError"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "csrfCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas/api-payloads.schema.json#/$defs/TokenRequest"
              }
            }
          }
        },
        "x-registered-when": "auth_mode=email"
      }
    },
    "/api/auth/reset-password/forgot-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "requestPasswordReset",
        "responses": {
          "202": {
            "description": "Reset request accepted."
          },
          "400": {
            "$ref": "#/components/responses/AuthError"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
