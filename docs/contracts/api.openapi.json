            },
            "application/x-hdf5": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            },
            "application/json": {
              "schema": {
                "type": "string",
                "contentEncoding": "binary"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/assetMetadata"
          }
        ],
        "description": "Upload bytes in the request body. X-Asset-Metadata contains the JSON metadata envelope."
      }
    },
