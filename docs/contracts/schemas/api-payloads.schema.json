{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geophysics.ml.fasl-work.com/contracts/api-payloads/v1",
  "title": "CAOS Geophysics private API payloads",
  "$defs": {
    "ProjectCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        }
      }
    },
    "ProjectUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "SourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "rights_statement",
        "rights_decision",
        "private_storage_permission",
        "attribution"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "citation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "rights_statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000
        },
        "rights_decision": {
          "enum": [
            "mirror",
            "provider-link-only",
            "derivative-only",
            "forbidden"
          ]
        },
        "private_storage_permission": {
          "const": "attested"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "PhysicalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_reference",
        "axis_order",
        "horizontal_datum",
        "vertical_datum",
        "vertical_positive",
        "horizontal_unit",
        "vertical_unit",
        "measurement_unit",
        "epoch_utc",
        "component_frame",
        "geometry"
      ],
      "properties": {
        "coordinate_reference": {
          "enum": [
            "epsg",
            "local"
          ]
        },
        "epsg": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000,
          "maximum": 999999
        },
        "local_crs": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 5,
          "maxLength": 500
        },
        "axis_order": {
          "enum": [
            "xy",
            "yx",
            "lon_lat",
            "lat_lon"
          ]
        },
        "horizontal_datum": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "vertical_datum": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "vertical_positive": {
          "enum": [
            "up",
            "down"
          ]
        },
        "horizontal_unit": {
          "enum": [
            "m",
            "km",
            "degree"
          ]
        },
        "vertical_unit": {
          "enum": [
            "m",
            "ft"
          ]
        },
        "measurement_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "epoch_utc": {
          "type": "string",
          "format": "date-time"
        },
        "component_frame": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "geometry": {
          "type": "object",
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coordinate_reference": {
                "const": "epsg"
              }
            }
          },
          "then": {
            "required": [
              "epsg"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate_reference": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "local_crs"
            ]
          }
        }
      ]
    },
    "AssetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "mime",
        "format",
        "source",
        "physical"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "format": {
          "enum": [
            "gravity_csv",
            "magnetic_csv",
            "traveltime_csv",
            "ert_csv",
            "geotiff",
            "edi",
            "miniseed",
            "stationxml",
            "segy",
            "mth5",
            "ert_ohm",
            "traveltime_sgt"
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceInput"
        },
        "physical": {
          "$ref": "#/$defs/PhysicalInput"
        }
      }
    },
    "PhysicalAssetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "mime",
        "format",
        "source",
        "physical"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime": {
          "const": "application/json"
        },
        "format": {
          "const": "gravity_stations_json"
        },
        "source": {
          "$ref": "#/$defs/SourceInput"
        },
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version"
          ],
          "properties": {
            "schema_version": {
              "const": "gravity-stations-1"
            }
          }
        }
      }
    },
    "UploadMetadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/AssetMetadata"
        },
        {
          "$ref": "#/$defs/PhysicalAssetMetadata"
        }
      ]
    },
    "DatasetCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "waveform_request": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "profile_metadata": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "GravityJobParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold"
      ],
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "M05Parameters": {
      "type": "object",
      "additionalProperties": false
    },
    "M06Parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qc_job_id",
        "thickness_m",
        "initial_ohm_m",
        "beta"
      ],
      "properties": {
        "qc_job_id": {
          "type": "string",
          "format": "uuid"
        },
        "thickness_m": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "number",
            "minimum": 2,
            "maximum": 4000
          }
        },
        "initial_ohm_m": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 1,
            "exclusiveMaximum": 6000
          }
        },
        "beta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bootstrap_samples": {
          "type": "integer",
          "minimum": 20,
          "maximum": 40,
          "default": 20
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 61001
        }
      }
    },
    "ProfileParameters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Currently an empty frozen parameter model; solver configuration is controlled by the installed implementation."
    },
    "WaveformParameters": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scientific_request_sha256"
      ],
      "properties": {
        "scientific_request_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "description": "The exact frozen waveform parameter model is defined in app/waveform_contract.py."
    },
    "JobCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "method_id",
        "parameters"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "format": "uuid"
        },
        "method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/GravityJobParameters"
            },
            {
              "$ref": "#/$defs/M05Parameters"
            },
            {
              "$ref": "#/$defs/M06Parameters"
            },
            {
              "$ref": "#/$defs/ProfileParameters"
            },
            {
              "$ref": "#/$defs/WaveformParameters"
            }
          ]
        }
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FrameworkError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail"
      ],
      "properties": {
        "detail": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "loc",
                  "msg",
                  "type"
                ],
                "properties": {
                  "loc": {
                    "type": "array"
                  },
                  "msg": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "input": {},
                  "ctx": {
                    "type": "object"
                  }
                },
                "additionalProperties": true
              }
            }
          ]
        }
      }
    },
    "AuthConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "registration_enabled",
        "mail_flows_enabled"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "email"
          ]
        },
        "registration_enabled": {
          "type": "boolean"
        },
        "mail_flows_enabled": {
          "type": "boolean"
        }
      }
    },
    "UserCreate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 12
        }
      },
      "description": "The email-registration router is installed only for auth_mode=email; local auth does not expose account creation."
    },
    "EmailRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "TokenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "PasswordReset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "password"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "CsrfToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "csrf_token"
      ],
      "properties": {
        "csrf_token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "User": {
      "type": "object",
      "required": [
        "id",
        "email",
        "is_active",
        "is_superuser",
        "is_verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "is_active": {
          "type": "boolean"
        },
        "is_superuser": {
          "type": "boolean"
        },
        "is_verified": {
          "type": "boolean"
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects"
      ],
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Project"
          }
        }
      }
    },
    "UploadLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "filename"
      ],
      "properties": {
        "kind": {
          "const": "upload"
        },
        "filename": {
          "type": "string"
        }
      }
    },
    "SourceRecordView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "version",
        "provider",
        "location",
        "doi",
        "citation",
        "retrieved_at",
        "rights_statement",
        "rights_decision",
        "private_storage_permission",
        "declared_format",
        "expected_bytes",
        "sha256",
        "attribution"
      ],
      "properties": {
        "schema_version": {
          "const": "geophysics.source-record-view/v1"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/UploadLocation"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "rights_statement": {
          "type": "string"
        },
        "rights_decision": {
          "enum": [
            "mirror",
            "provider-link-only",
            "derivative-only",
            "forbidden"
          ]
        },
        "private_storage_permission": {
          "enum": [
            "attested",
            null
          ]
        },
        "declared_format": {
          "type": "string"
        },
        "expected_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "RawAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "asset_id",
        "owner_id",
        "project_id",
        "source_id",
        "source",
        "original_filename",
        "mime_type",
        "detected_format",
        "byte_count",
        "sha256",
        "physical_metadata",
        "validation_status",
        "created_at",
        "receipt",
        "download_url"
      ],
      "properties": {
        "schema_version": {
          "const": "geophysics.raw-asset-view/v1"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "$ref": "#/$defs/SourceRecordView"
        },
        "original_filename": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "detected_format": {
          "type": "string"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "physical_metadata": {
          "type": "object"
        },
        "validation_status": {
          "const": "raw_metadata_checked"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt": {
          "type": "string"
        },
        "download_url": {
          "type": "string"
        }
      }
    },
    "AssetList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawAsset"
          }
        }
      }
    },
    "DatasetReceipt": {
      "type": "object",
      "required": [
        "dataset_id",
        "project_id",
        "raw_asset_id",
        "version",
        "schema",
        "modality",
        "row_count",
        "parser_version",
        "raw_sha256",
        "sha256",
        "created_at",
        "qc_verdict"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "raw_asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "const": 1
        },
        "schema": {
          "const": "geophysics.observation-dataset/v1"
        },
        "modality": {
          "type": "string"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "parser_version": {
          "type": "string"
        },
        "raw_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "qc_verdict": {
          "type": "string"
        }
      }
    },
    "DatasetReceiptList": {
      "type": "object",
      "required": [
        "datasets"
      ],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatasetReceipt"
          }
        }
      }
    },
    "MethodEligibility": {
      "type": "object",
      "required": [
        "method_id",
        "eligible",
        "lane"
      ],
      "properties": {
        "method_id": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "lane": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reason_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Dataset or admission fields that explain why an ineligible method is filtered."
        },
        "source_eligible": {
          "type": "boolean",
          "description": "Whether source declarations pass the method source gate; not host admission."
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Detailed source-admission failures when source_eligible is false."
        },
        "qc_job_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "eligible": { "const": false } },
            "required": ["eligible"]
          },
          "then": { "required": ["reason", "reason_fields"] }
        },
        {
          "if": {
            "properties": { "eligible": { "const": true } },
            "required": ["eligible"]
          },
          "then": { "required": ["scope"] }
        }
      ]
    },
    "Methods": {
      "type": "object",
      "required": [
        "dataset_id",
        "methods",
        "unavailable"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "format": "uuid"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodEligibility"
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodEligibility"
          }
        }
      }
    },
    "Job": {
      "type": "object",
      "required": [
        "job_id",
        "project_id",
        "dataset_id",
        "dataset_sha256",
        "method_id",
        "request",
        "request_sha256",
        "preflight",
        "state",
        "cancel_requested",
        "created_at",
        "started_at",
        "finished_at",
        "wall_ms",
        "peak_rss_bytes",
        "scratch_bytes",
        "result_sha256",
        "error",
        "result_url"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "dataset_id": {
