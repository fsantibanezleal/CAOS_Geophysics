[Unit]
Description=Geophysics private-state API
Requires=geophysics-api.socket
After=geophysics-api.socket

[Service]
Type=simple
User=geophysics
Group=geophysics
WorkingDirectory=/var/www/geophysics.ml.fasl-work.com/current/source
EnvironmentFile=/etc/geophysics/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/var/www/geophysics.ml.fasl-work.com/current/.venv/bin/python -m uvicorn app.main:app --fd 3 --proxy-headers --forwarded-allow-ips=* --workers 1 --limit-concurrency 64 --timeout-keep-alive 5 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/geophysics
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M
MemorySwapMax=0
TasksMax=96
CPUQuota=150%

[Install]
WantedBy=multi-user.target
