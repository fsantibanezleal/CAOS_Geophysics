[Unit]
Description=Geophysics bounded scientific processing worker
After=geophysics-api.service

[Service]
Type=simple
User=geophysics
Group=geophysics
WorkingDirectory=/var/www/geophysics.ml.fasl-work.com/current/source
EnvironmentFile=/etc/geophysics/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONIOENCODING=utf-8
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/var/www/geophysics.ml.fasl-work.com/current/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/geophysics
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=2G
MemoryHigh=1536M
MemorySwapMax=0
TasksMax=96
CPUQuota=200%

[Install]
WantedBy=multi-user.target
